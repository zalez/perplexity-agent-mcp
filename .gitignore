# --- Secrets -----------------------------------------------------------------
# Nothing in this repo should ever contain a credential. These patterns are a
# backstop, not a permission slip: gitleaks runs in pre-commit and CI as well.
.env
.env.*
*.env
.envrc
secrets.json
*.pem
*.key

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
MANIFEST

# --- Virtual environments ----------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version

# --- Tool caches -------------------------------------------------------------
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# --- Editors / IDEs ----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.\#*
\#*\#

# --- macOS -------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*

# --- Misc --------------------------------------------------------------------
*.log
.claude/settings.local.json
